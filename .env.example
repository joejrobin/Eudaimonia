# Copy to `.env` (git-ignored). devenv loads it into the dev shell; docker compose
# reads it for variable substitution. Every value has a safe development default,
# so the file is optional locally. Change all secrets before exposing a node.

# Node identity
NODE_NAME=dev-node
LOG_LEVEL=info

# Postgres (compose creates this database; devenv creates the same one locally)
POSTGRES_USER=eudaimonia
POSTGRES_PASSWORD=eudaimonia
POSTGRES_DB=eudaimonia

# LiveKit SFU. The key/secret pair must match on the node and the SFU.
# LIVEKIT_URL is the address *browsers* use to reach the SFU.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Embedded in the backend image at build time
VERSION=dev
